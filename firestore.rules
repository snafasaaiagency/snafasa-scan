rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == "admin";
    }

    function isPremium() {
      return isSignedIn() && getUserData().plan in ["tier1", "tier2", "tier3", "tier4"];
    }

    // ── Users collection ───────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Prevent regular users from modifying plan or role fields directly
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'role'])
      );
      allow delete: if isAdmin();
    }

    // ── Conversions history collection (premium feature) ──────
    match /conversions/{conversionId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isPremium() && request.resource.data.uid == request.auth.uid;
    }

    // ── Pending Payments collection ────────────────────────────
    match /pendingPayments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.uid == request.auth.uid && 
        resource.data.status == "awaiting_payment" && 
        request.resource.data.status == "submitted"
      );
      allow delete: if isAdmin();
    }
  }
}
